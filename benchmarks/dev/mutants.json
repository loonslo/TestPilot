    },
    {
      "id": "mut-09",
      "title": "Income transactions are added to the cash balance",
      "rules": [
        "LED-02"
      ],
      "expected_violations": [
        "LED-02"
      ],
      "replacements": [
        {
          "file": "src/finunity_server/v1_api.py",
          "old": "        if item[\"transaction_type\"] in {\"DEPOSIT\", \"DIVIDEND\", \"INTEREST\"}:\n            aggregate[\"income_minor\"] += amount",
          "new": "        if item[\"transaction_type\"] in {\"DEPOSIT\", \"DIVIDEND\", \"INTEREST\"}:\n            aggregate[\"income_minor\"] += amount\n            aggregate[\"cash_balance_minor\"] += amount"
        }
      ]
