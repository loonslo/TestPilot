            "pattern": "^-?\\d+(\\.\\d+)?$",
            "title": "Amount",
            "type": "string"
          },
          "currency": {
            "pattern": "^[A-Z]{3,5}$",
            "title": "Currency",
            "type": "string"
          },
          "holding_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
