          "occurred_at": {
            "maxLength": 40,
            "minLength": 10,
            "title": "Occurred At",
            "type": "string"
          },
          "price": {
            "anyOf": [
              {
                "pattern": "^\\d+(\\.\\d+)?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price"
          },
          "quantity": {
            "anyOf": [
              {
                "pattern": "^\\d+(\\.\\d+)?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          },
          "source_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Id"
          },
          "to_account_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "To Account Id"
          },
          "transaction_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transaction Id"
          },
          "transaction_type": {
            "pattern": "^(BUY|SELL|DIVIDEND|DEPOSIT|WITHDRAWAL|FEE|INTEREST|TRANSFER|OTHER)$",
            "title": "Transaction Type",
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "transaction_type",
          "amount",
          "currency",
          "occurred_at"
        ],
        "title": "TransactionItem",
        "type": "object"
      },
      "TransactionsBatchRequest": {
        "additionalProperties": false,
        "properties": {
          "client_request_id": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Client Request Id",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/TransactionItem"
            },
            "maxItems": 500,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "client_request_id",
          "items"
        ],
        "title": "TransactionsBatchRequest",
        "type": "object"
      }
