{
  "components": {
    "schemas": {
      "AccountRequest": {
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Id"
          },
          "account_type": {
            "pattern": "^(BROKERAGE|FUND|BANK|CRYPTO|OTHER)$",
            "title": "Account Type",
            "type": "string"
          },
          "currency": {
            "default": "CNY",
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          },
          "institution": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Institution"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "opening_balance": {
            "default": "0",
            "pattern": "^\\d+(\\.\\d{1,2})?$",
            "title": "Opening Balance",
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "name",
          "account_type"
        ],
        "title": "AccountRequest",
        "type": "object"
      },
      "ArchiveRequest": {
        "additionalProperties": false,
        "properties": {
          "version": {
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version"
        ],
        "title": "ArchiveRequest",
        "type": "object"
      },
      "HoldingItem": {
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Id"
          },
          "asset_type": {
            "pattern": "^(STOCK|ETF|FUND|LOF|REIT|BOND|CASH|CRYPTO|OTHER)$",
            "title": "Asset Type",
            "type": "string"
          },
          "average_cost": {
            "anyOf": [
              {
                "pattern": "^\\d+(\\.\\d+)?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Average Cost"
          },
          "currency": {
            "pattern": "^[A-Z]{3,5}$",
            "title": "Currency",
            "type": "string"
          },
          "holding_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Holding Id"
          },
          "instrument_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instrument Id"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "quantity": {
            "pattern": "^\\d+(\\.\\d+)?$",
            "title": "Quantity",
            "type": "string"
          },
          "snapshot_date": {
            "anyOf": [
              {
                "maxLength": 40,
                "minLength": 10,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Date"
          },
          "source_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Id"
          },
          "version": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "name",
          "asset_type",
          "quantity",
          "currency"
        ],
        "title": "HoldingItem",
        "type": "object"
      },
      "HoldingsBatchRequest": {
        "additionalProperties": false,
        "properties": {
          "client_request_id": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Client Request Id",
            "type": "string"
