# Keep text files LF in the working tree regardless of the host's
# core.autocrlf setting: benchmark assets are contractually LF+UTF-8 and
# are hashed/compared byte-for-byte.
* text=auto eol=lf

# Windows launchers stay CRLF for cmd.exe compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touch binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
